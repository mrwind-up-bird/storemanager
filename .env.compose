# ─────────────────────────────────────────────────────────────────────────────
# Dev-only docker compose environment for the app services (migrate/seed/web/worker).
# NEVER use these values in production. The db roles (qr_owner / qr_app) and their
# passwords are created by docker/postgres/init/01-roles.sql from the db service's
# QR_OWNER_PASSWORD / QR_APP_PASSWORD env (see docker-compose.yml) — the user:pass in
# the URLs below MUST match those.
# ─────────────────────────────────────────────────────────────────────────────

# qr_app: runtime role, NON-superuser, NOBYPASSRLS — every query bound by RLS.
DATABASE_URL=postgresql://qr_app:app_secret@db:5432/qrecords
# qr_owner: migrations + registry writes (BYPASSRLS).
DATABASE_OWNER_URL=postgresql://qr_owner:owner_secret@db:5432/qrecords
# pg-boss owns the `pgboss` schema, runs as qr_owner.
PGBOSS_DATABASE_URL=postgresql://qr_owner:owner_secret@db:5432/qrecords

# Domain / URL construction. *.localhost resolves to loopback in browsers automatically.
ROOT_DOMAIN=localhost
APP_PROTOCOL=http
APP_PORT=3000

# Auth.js secret (≥ 32 chars). Dev value only.
AUTH_SECRET=dev-auth-secret-minimum-32-characters-long-xx

# AES-256 key: base64 of exactly 32 bytes (validated by src/env.ts + the web boot guard).
ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
ENCRYPTION_KEY_ID=v1

# Mail → Mailpit (SMTP on the mailpit service; HTTP UI/API on :8025).
MAIL_DRIVER=mailpit
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM=noreply@localhost

# Pool / timeouts.
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=10000
DB_IDLE_TX_TIMEOUT_MS=10000

# Fixed dev password so the seeded demo/vinylcave admins have deterministic E2E credentials.
SEED_ADMIN_PASSWORD=E2eDevPassword1!
